{
    "global": {
        "tick_interval_ms": 100,
        "log_dir": "/var/log/phmd",
        "enable_auto_recovery": true,
        "event_queue_size": 1024
    },
    "supervised_entities": [
        {
            "name": "adas_perception",
            "description": "ADAS 感知融合模块，负责目标检测和跟踪",
            "alive_timeout_ms": 5000,
            "auto_restart": true,
            "max_restart_count": 3,
            "restart_delay_s": 5,
            "dependencies": ["camera_driver", "lidar_driver"],
            "monitors": [
                {
                    "type": "process_lifecycle",
                    "enabled": true,
                    "interval_ms": 1000,
                    "params": {
                        "process_name": "adas_perception",
                        "process_path": "/opt/faw/bin/adas_perception"
                    }
                },
                {
                    "type": "resource",
                    "enabled": true,
                    "interval_ms": 2000,
                    "warn_threshold_cpu": 80.0,
                    "error_threshold_cpu": 95.0,
                    "debounce_count": 3
                },
                {
                    "type": "alive",
                    "enabled": true,
                    "interval_ms": 1000,
                    "timeout_ms": 5000
                },
                {
                    "type": "deadlock",
                    "enabled": true,
                    "interval_ms": 5000,
                    "timeout_ms": 2000
                }
            ]
        },
        {
            "name": "camera_driver",
            "description": "摄像头驱动，提供图像数据",
            "alive_timeout_ms": 3000,
            "auto_restart": true,
            "max_restart_count": 5,
            "monitors": [
                {
                    "type": "process_lifecycle",
                    "enabled": true,
                    "interval_ms": 500,
                    "params": {
                        "process_name": "camera_driver"
                    }
                },
                {
                    "type": "resource",
                    "enabled": true,
                    "interval_ms": 3000,
                    "warn_threshold_cpu": 50.0,
                    "error_threshold_cpu": 80.0
                }
            ]
        },
        {
            "name": "planning_control",
            "description": "路径规划和车辆控制模块",
            "alive_timeout_ms": 5000,
            "auto_restart": true,
            "dependencies": ["adas_perception"],
            "monitors": [
                {
                    "type": "process_lifecycle",
                    "enabled": true,
                    "interval_ms": 1000,
                    "params": {
                        "process_name": "planning_control"
                    }
                },
                {
                    "type": "alive",
                    "enabled": true,
                    "interval_ms": 500,
                    "timeout_ms": 3000
                },
                {
                    "type": "deadlock",
                    "enabled": true,
                    "interval_ms": 3000,
                    "timeout_ms": 1000
                }
            ]
        },
        {
            "name": "localization",
            "description": "GNSS+IMU 融合定位模块",
            "alive_timeout_ms": 6000,
            "auto_restart": true,
            "monitors": [
                {
                    "type": "process_lifecycle",
                    "enabled": true,
                    "interval_ms": 1000,
                    "params": {
                        "process_name": "localization"
                    }
                },
                {
                    "type": "resource",
                    "enabled": true,
                    "interval_ms": 5000,
                    "warn_threshold_cpu": 60.0,
                    "warn_threshold_memory_mb": 256,
                    "error_threshold_memory_mb": 512
                },
                {
                    "type": "alive",
                    "enabled": true,
                    "interval_ms": 1000
                }
            ]
        },
        {
            "name": "data_recorder",
            "description": "数据记录模块，非关键",
            "alive_timeout_ms": 10000,
            "auto_restart": false,
            "monitors": [
                {
                    "type": "process_lifecycle",
                    "enabled": true,
                    "interval_ms": 5000,
                    "params": {
                        "process_name": "data_recorder"
                    }
                }
            ]
        }
    ]
}